# API key for Jev evaluation. Local inference does not use it.
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# The local server listens on 127.0.0.1 by default.
NECRO_API_KEY=necro-local
NECRO_MODEL=Qwen/Qwen3.5-0.8B
# Optional local LoRA directory. Install PEFT with --extra training.
NECRO_ADAPTER=
NECRO_DEVICE=auto
NECRO_BATCH_SIZE=4
NECRO_BATCH_TOKENS=8192
NECRO_TEMPERATURE=1.0
# Optional Choice-only temperature. Leave empty to use NECRO_TEMPERATURE.
NECRO_CHOICE_TEMPERATURE=
