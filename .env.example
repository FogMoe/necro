# Jev 对照评测使用的密钥；本地推理不需要。
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# 本地服务默认只监听 127.0.0.1。
NECRO_API_KEY=necro-local
NECRO_MODEL=Qwen/Qwen3.5-0.8B
# 可选：通过验证的本地 LoRA 目录，需使用 --extra training 安装 PEFT。
NECRO_ADAPTER=
NECRO_DEVICE=auto
NECRO_BATCH_SIZE=4
NECRO_BATCH_TOKENS=8192
NECRO_TEMPERATURE=1.0
# 可选：只校准 Choice；留空沿用 NECRO_TEMPERATURE。
NECRO_CHOICE_TEMPERATURE=
