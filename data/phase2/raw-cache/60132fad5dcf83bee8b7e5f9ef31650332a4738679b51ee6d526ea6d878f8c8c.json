: []}, {"row_idx": 2610, "row": {"id": "15214", "label": "news_query", "label_text": "news_query", "text": "今天有什么新闻", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2611, "row": {"id": "15216", "label": "social_post", "label_text": "social_post", "text": "帮我发些微博", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2612, "row": {"id": "15225", "label": "social_query", "label_text": "social_query", "text": "显示我最新的通知", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2613, "row": {"id": "15229", "label": "social_query", "label_text": "social_query", "text": "我的朋友张三在微博有发什么新帖子吗", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2614, "row": {"id": "15231", "label": "social_post", "label_text": "social_post", "text": "把我去果阿的照片发到微博上", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2615, "row": {"id": "15249", "label": "social_query", "label_text": "social_query", "text": "有谁赞了我刚发的我的照片", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2616, "row": {"id": "15271", "label": "social_post", "label_text": "social_post", "text": "把这个发布到我的微博上", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2617, "row": {"id": "15274", "label": "social_query", "label_text": "social_query", "text": "查看我的社交媒体并且告诉我有什么事发生", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2618, "row": {"id": "15275", "label": "social_post", "label_text": "social_post", "text": "在微博发我很高兴", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2619, "row": {"id": "15276", "label": "social_post", "label_text": "social_post", "text": "在微博上发布一个新状态说我正在享受这个美好的天气", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2620, "row": {"id": "15280", "label": "social_query", "label_text": "social_query", "text": "微博", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2621, "row": {"id": "15289", "label": "social_post", "label_text": "social_post", "text": "现在发布消息", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2622, "row": {"id": "15296", "label": "social_query", "label_text": "social_query", "text": "给我读我的首页最新的帖子", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2623, "row": {"id": "15298", "label": "social_query", "label_text": "social_query", "text": "小度社交媒体有什么热门话题", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2624, "row": {"id": "15304", "label": "social_query", "label_text": "social_query", "text": "今天微博有谁关注我了", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2625, "row": {"id": "15305", "label": "calendar_query", "label_text": "calendar_query", "text": "我收到任何社交媒体的通知了吗", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2626, "row": {"id": "15311", "label": "social_query", "label_text": "social_query", "text": "告诉我微博是怎么回事", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2627, "row": {"id": "15318", "label": "social_post", "label_text": "social_post", "text": "我想感谢所有人的生日祝福", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2628, "row": {"id": "15321", "label": "social_query", "label_text": "social_query", "text": "有什么人评论我的状态吗", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2629, "row": {"id": "15326", "label": "social_query", "label_text": "social_query", "text": "朗读我的微博订阅源", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2630, "row": {"id": "15333", "label": "social_query", "label_text": "social_query", "text": "唯品会有什么新品", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2631, "row": {"id": "15337", "label": "social_post", "label_text": "social_post", "text": "把这个视频发到微博", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2632, "row": {"id": "15345", "label": "social_query", "label_text": "social_query", "text": "查看微博热搜", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2633, "row": {"id": "15348", "label": "social_query", "label_text": "social_query", "text": "现在谁在做微博直播", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2634, "row": {"id": "15350", "label": "social_post", "label_text": "social_post", "text": "我不满意淘宝请帮我", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2635, "row": {"id": "15358", "label": "social_post", "label_text": "social_post", "text": "发微博告诉华为说手机不能用了", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2636, "row": {"id": "15359", "label": "social_post", "label_text": "social_post", "text": "打开微博发给华为说我的手机电池总是没电", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2637, "row": {"id": "15364", "label": "social_post", "label_text": "social_post", "text": "你能告诉淘宝这个新的手机壳是垃圾吗", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2638, "row": {"id": "15382", "label": "social_post", "label_text": "social_post", "text": "你能联系三星说我的洗衣机着火了吗", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2639, "row": {"id": "15387", "label": "social_post", "label_text": "social_post", "text": "把我的现在的位置发微博", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2640, "row": {"id": "15399", "label": "social_post", "label_text": "social_post", "text": "就网络相关问题向手机运营商提出投诉", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2641, "row": {"id": "15401", "label": "social_post", "label_text": "social_post", "text": "打开推特发送信息", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2642, "row": {"id": "15402", "label": "social_post", "label_text": "social_post", "text": "发微博说那个产品很差", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2643, "row": {"id": "15409", "label": "social_post", "label_text": "social_post", "text": "打开微博写下我的投诉并且发给客服", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2644, "row": {"id": "15413", "label": "social_post", "label_text": "social_post", "text": "尽快给我找个人来", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2645, "row": {"id": "15444", "label": "social_post", "label_text": "social_post", "text": "在公司名称上打两个大拇指", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2646, "row": {"id": "15445", "label": "social_query", "label_text": "social_query", "text": "告诉我照片墙上发生了什么", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2647, "row": {"id": "15448", "label": "social_post", "label_text": "social_post", "text": "发条微博说小米的音量问题", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2648, "row": {"id": "15454", "label": "social_post", "label_text": "social_post", "text": "用微博发我很生气春秋航空把我的行李弄丢了", "lang": "zh-CN"}, "truncated_cells": []}, {"row_idx": 2649, "row": {"id": "15456", "label": "social_post", "label_text": "social_post", "text": "我想发条推特给美国联合航空公司说我很生气你们弄丢了我的行李", "lang": "zh-CN"}, "truncated_cells": []}], "num_rows_total": 2974, "num_rows_per_page": 100, "partial": false}